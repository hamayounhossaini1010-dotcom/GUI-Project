           <item row="6" column="1"><widget class="QDoubleSpinBox" name="spinEnglish"><property name="maximum"><double>100.0</double></property></widget></item>
           <item row="7" column="0"><widget class="QLabel" name="lComputer"><property name="text"><string>Computer (0–100):</string></property></widget></item>
           <item row="7" column="1"><widget class="QDoubleSpinBox" name="spinComputer"><property name="maximum"><double>100.0</double></property></widget></item>
